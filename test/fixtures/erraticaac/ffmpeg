#!/bin/sh
# Runs the ffmpeg on PATH, except the loudness measurements of an .m4a, the AAC
# sound of video.mp4, which read the true peaks listed in $MUSICFIT_TEST_PEAKS,
# the next one each time, as an AAC encoder that lifts a peak by another
# amount each time it encodes does, and the loudness listed in
# $MUSICFIT_TEST_LOUDNESS (-14.0 when it lists none), or with that set to real
# the loudness the file has, which it adds to $MUSICFIT_TEST_STATE.loudness.
# It keeps the packets of each .m4a it measured as $MUSICFIT_TEST_STATE.<n>,
# so a test can tell which one was kept.
meter= m4a=
for arg do
  case $arg in
    ebur128=*) meter=1 ;;
    *.m4a) m4a=$arg ;;
  esac
done
if [ -n "$meter" ] && [ -n "$m4a" ]; then
  count=$(cat "$MUSICFIT_TEST_STATE" 2>/dev/null || echo 0)
  count=$((count + 1))
  echo $count > "$MUSICFIT_TEST_STATE"
  ffmpeg -hide_banner -nostdin -v error -i "$m4a" -map 0:a -c copy -f framecrc - | grep -v '^#' > "$MUSICFIT_TEST_STATE.$count"
  peak=$(echo "$MUSICFIT_TEST_PEAKS" | cut -d' ' -f$count)
  if [ "${MUSICFIT_TEST_LOUDNESS:-}" = real ]; then
    loudness=$(ffmpeg -hide_banner -nostdin -nostats -i "$m4a" -map 0:a:0 -af ebur128=peak=true:framelog=verbose -f null - 2>&1 | sed -n '/Summary:/,$p' | awk '$1 == "I:" { print $2 }')
    echo "$loudness" >> "$MUSICFIT_TEST_STATE.loudness"
  else
    loudness=$(echo "${MUSICFIT_TEST_LOUDNESS:-}" | cut -d' ' -f$count)
  fi
  cat >&2 <<LINES
[Parsed_ebur128_0 @ 0x55ac8659cdc0] Summary:

  Integrated loudness:
    I:         ${loudness:--14.0} LUFS
    Threshold: -24.0 LUFS

  Loudness range:
    LRA:         5.0 LU
    Threshold: -34.0 LUFS
    LRA low:   -18.0 LUFS
    LRA high:  -13.0 LUFS

  True peak:
    Peak:       $peak dBFS
LINES
  exit 0
fi
exec ffmpeg "$@"
