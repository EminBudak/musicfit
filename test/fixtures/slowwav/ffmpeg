#!/bin/sh
# Runs the ffmpeg on PATH, but before the call that writes a 24-bit WAV it
# writes its process number to $MUSICFIT_TEST_MARK and waits, so a test can
# stop the run while it writes, and see whether this process outlives it.
for arg do
  if [ "$arg" = pcm_s24le ]; then
    echo $$ > "$MUSICFIT_TEST_MARK"
    sleep 10
  fi
done
exec ffmpeg "$@"
