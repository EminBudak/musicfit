#!/bin/sh
# Runs the ffmpeg on PATH, except the call that writes mix.wav, the last
# sound a fit with a voice writes, which fails the way a full disk does.
for arg do
  last=$arg
done
case $last in
  *mix.wav)
    echo "[out#0/wav @ 0x6326ca169a40] Error writing trailer: No space left on device" >&2
    exit 1
    ;;
esac
exec ffmpeg "$@"
