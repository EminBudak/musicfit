#!/bin/sh
# Runs the ffmpeg on PATH, except the call that writes a file whose name ends
# in $MUSICFIT_TEST_TRAILER, which ends the way ffmpeg 4.4 does when the disk
# fills as it writes the file's index: it says so, leaves a file no player
# reads, and exits with 0. With $MUSICFIT_TEST_QUIET set it says nothing.
for arg do
  last=$arg
done
[ -n "$MUSICFIT_TEST_TRAILER" ] || exec ffmpeg "$@"
case $last in
  *"$MUSICFIT_TEST_TRAILER")
    ffmpeg "$@" || exit
    printf 'cut short' > "$last"
    [ -n "$MUSICFIT_TEST_QUIET" ] || echo "Error writing trailer of $last: No space left on device" >&2
    exit 0
    ;;
esac
exec ffmpeg "$@"
