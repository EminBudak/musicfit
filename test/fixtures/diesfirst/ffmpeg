#!/bin/sh
# Ctrl-C reaches the whole process group: this ffmpeg, which writes a WAV,
# ends at once, as ffmpeg does on SIGINT, and node hears its own SIGINT a
# moment later, once it has taken in that ffmpeg failed. The SIGINT comes
# from a process that holds none of ffmpeg's pipes, so they close now.
for arg do
  if [ "$arg" = pcm_s24le ]; then
    (sleep 0.3; kill -INT $PPID) </dev/null >/dev/null 2>&1 &
    echo "Exiting normally, received signal 2." >&2
    exit 255
  fi
done
exec ffmpeg "$@"
